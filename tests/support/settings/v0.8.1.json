{
    "version": 1,
    "language": "en",
    "compressProjectFiles": false,
    "mediaPathMode": "project",
    "theme": {
        "mode": "system",
        "translucentSidebar": false,
        "sidebarTransparency": 50,
        "light": {
            "--c-accent": "#d05a32",
            "--c-background": "#ffffff",
            "--c-text": "#252a30"
        },
        "dark": {
            "--c-accent": "#58a6ff",
            "--c-background": "#161b22",
            "--c-text": "#e6edf3"
        }
    },
    "transcription": {
        "concurrency": 2,
        "presets": {
            "A": {
                "executor": "whisper.cpp",
                "backendDirectory": "whisper-custom",
                "modelDirectory": "model-custom",
                "params": {
                    "language": "en",
                    "prompt": "Release fixture A"
                }
            }
        },
        "lastConfig": null
    },
    "editing": {
        "followPlayback": false,
        "fontSize": 16,
        "informationDisplay": "tooltip",
        "hideTrivialInformation": false,
        "referenceOverlap": 50
    },
    "volumeStabilization": {
        "maxGainDb": 30,
        "gainAttackMs": 25,
        "gainReleaseMs": 800,
        "gateThresholdDb": -50,
        "targetLevelDb": -15
    },
    "window": {
        "width": 1060,
        "height": 740,
        "maximized": false
    },
    "layout": {
        "sidebarWidth": null,
        "videoHeight": null
    },
    "playback": {
        "mode": "single",
        "volumeSliderMapping": "amplitude",
        "volumeSliderMinDb": -60,
        "mediaSwitchPlayback": "keep",
        "wordSwitchPlayback": "keep",
        "rewindStepMs": 2000,
        "startRewindMs": 0,
        "rememberPlaybackPosition": true,
        "pauseOnOutputDeviceChange": true,
        "audioOffsetMs": 0,
        "showLevelMeter": true,
        "levelMeterReadout": "source",
        "volumeStabilization": false,
        "volume": 1,
        "speed": 1.25,
        "savedSpeed": null
    }
}